# ── 依赖 ────────────────────────────────────────────────
node_modules/
package-lock.json

# ── 用户职业数据（绝不应提交）────────────────────────────
# 首次运行会在工作区建 <工作区>/career/ 数据目录。
# 如果工作区恰好是这个仓库目录，下面这条会挡住真实数据。
career/

# ── 审计日志与备份 ──────────────────────────────────────
*.jsonl
*.backup-*
events.backup-*

# ── 简历原件（隐私）─────────────────────────────────────
*.pdf
*.doc
*.docx
!test-*.pdf

# ── npm 凭证（绝不应提交）───────────────────────────────
# 仓库内可能有一个只写 registry 的 .npmrc；但若被写入 token，
# 这条能防止它随 git 泄露。
.npmrc

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── 临时与构建产物 ──────────────────────────────────────
__ptmp/
__release-build/
*.log
npm-debug.log*
*.tgz
