# ── 依赖 ────────────────────────────────────────────────
node_modules/
package-lock.json

# ── 用户职业数据（绝不应提交）────────────────────────────
# 首次运行会把数据层播种到工作区 <工作区>/career/。
# 如果工作区恰好是这个仓库目录，下面这条会挡住真实数据。
# 注意：它只匹配名为 career 的目录，不影响 career-workbench/ 和 career-planner/。
career/

# ── 审计日志与备份 ──────────────────────────────────────
*.jsonl
*.backup-*
events.backup-*

# ── 简历原件（隐私）─────────────────────────────────────
*.pdf
*.doc
*.docx
!test-*.pdf

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── 临时与构建产物 ──────────────────────────────────────
__ptmp/
__release-build/
*.log
npm-debug.log*
