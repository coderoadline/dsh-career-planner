{
  "name": "dsh-career-planner",
  "version": "1.7.1",
  "type": "module",
  "description": "职业规划工作台 + 职业规划师预设：插件把包内预设自动同步到 DSH，界面与 AI 共用同一份职业数据（画像 / JD 池 / 投递 / 技能 / 简历）",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./store/*": "./store/*"
  },
  "files": [
    "index.js",
    "client.js",
    "preset-sync.mjs",
    "cordis.patch.yml",
    "store",
    "presets"
  ],
  "dependencies": {
    "officeparser": "^8.0.0"
  },
  "author": "coderoadline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderoadline/dsh-career-planner.git"
  },
  "homepage": "https://github.com/coderoadline/dsh-career-planner#readme",
  "bugs": {
    "url": "https://github.com/coderoadline/dsh-career-planner/issues"
  },
  "keywords": ["dsh", "deepseek-harness", "plugin", "career", "job-search", "resume"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
